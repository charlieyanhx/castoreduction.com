# Castor Research — every environment variable this app reads.
#
# Copy to .env for local development. In production set them in the host's dashboard
# (Render: Environment; Fly: `flyctl secrets set`), not in a file in the image.
#
# The three sections are ordered by what stops the product working:
#   1. REQUIRED — without these it does not run, or it runs unsafely.
#   2. THE PRODUCT — payments, email, Google sign-in. Each stays dormant until complete.
#   3. RESEARCH ENGINE — data sources. All optional; each absence costs a specific section.
#
# A NOTE ON "DORMANT". billing and mailer both refuse to report themselves configured
# until EVERY variable they need is present, because a half-configured integration is
# worse than an absent one: Stripe with no webhook secret charges cards and grants
# nothing, and mail with no public URL sends reset links that are not links.


# =============================================================== 1. REQUIRED ==========

# At least ONE model provider. With several set, LLM_ALLOW_PAID decides whether the paid
# one is used at all — see below, it is the single most expensive line in this file.
#   Anthropic: https://console.anthropic.com/settings/keys
#   Gemini:    https://aistudio.google.com/apikey
#   Groq:      https://console.groq.com/keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# WITHOUT THIS, ANTHROPIC IS SILENTLY SKIPPED. fallback_chain() excludes paid backends
# unless the operator opts in, so a box with both an Anthropic and a Gemini key resolves
# to ['gemini'] alone: every customer runs on a shared free tier at 15 requests a minute,
# throttling constantly, and a throttled model is where reports go quietly wrong.
# The analyst report (report/synthesis.py, one claude-opus-5 pass over the fact layer,
# about $0.50 a run) waits on the same switch: without it, or without ANTHROPIC_API_KEY,
# the report page says the section was not written here and the run costs nothing more.
LLM_ALLOW_PAID=1

# Signs session cookies. REQUIRED when CASTOR_ENV=production — auth refuses to sign with
# a generated local key, so without it every login 500s while /healthz stays green.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# "production" turns on secure cookies and the boot-time misconfiguration guard.
CASTOR_ENV=

# The origin to build links against, with no trailing slash: https://app.example.com
# Every password-reset, confirmation and "report is ready" email carries a link, and it
# cannot be inferred from a request Host header without handing an attacker the ability
# to point your reset links at their own server. REQUIRED for any email to be sent.
CASTOR_PUBLIC_URL=

# Behind a TLS-terminating proxy (Render, Fly, Cloudflare), every request otherwise
# arrives from one address and the login limiter locks out every customer at once.
CASTOR_TRUST_PROXY=1


# =============================================================== 2. THE PRODUCT =======

# ---- Payments (Stripe). The two keys, plus a price for anything you want to sell. ----
# Prices are Stripe Price IDs, never amounts: changing what a report costs is a dashboard
# edit rather than a deploy. Webhook endpoint: POST {CASTOR_PUBLIC_URL}/billing/webhook
#   Keys:     https://dashboard.stripe.com/apikeys
#   Webhook:  https://dashboard.stripe.com/webhooks
#             events: checkout.session.completed, checkout.session.async_payment_succeeded
#   Prices:   https://dashboard.stripe.com/products  (copy the price_... id, not the name)
#
# BOTH KEYS OR NEITHER. With the secret key alone, cards are charged and every webhook is
# rejected, so a buyer pays for a credit that is never recorded. The app treats a
# half-configured instance as unconfigured for exactly this reason.
#
# The survey's paywall turns on the moment both keys are present: a report then costs a
# credit, and CASTOR_DAILY_RUNS is only what keeps an instance with no Stripe usable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# What one report costs. Without this, nothing can be sold at the gate.
STRIPE_PRICE_REPORT=
# The packs the landing page advertises. Each grants that many report credits (5 and 10);
# leave one blank and that button simply does not appear on the gate.
STRIPE_PRICE_BUNDLE5=
STRIPE_PRICE_BUNDLE10=
# The workshop pack: 30 workshop credits for $5, bought against ONE report from inside
# it. A paid report opens with 30 credits and a free-allowance report with 10; a chat
# turn or an Explain costs 1, a note is free, a rewrite costs 10. Blank, and the
# workshop cannot be topped up.
STRIPE_PRICE_WORKSHOP=

# ---- Email (Resend). Needs CASTOR_PUBLIC_URL above as well. -------------------------
# Without these: no password reset, no email verification, no "your report is ready".
# A forgotten password is an unrecoverable account, because sessions are stateless.
# MAIL_FROM must be on a domain you have verified with the provider.
#   Key:      https://resend.com/api-keys
#   Domain:   https://resend.com/domains  (verify it before MAIL_FROM will send)
RESEND_API_KEY=
MAIL_FROM=

# ---- Google sign-in. All three, or the button hides itself. -------------------------
# Redirect URI must match the one registered in Google Cloud exactly:
#   {CASTOR_PUBLIC_URL}/auth/google/callback
#   Console:  https://console.cloud.google.com/apis/credentials
#             Create an OAuth 2.0 Client ID of type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- Limits and overrides -----------------------------------------------------------
# Reports per owner per rolling 24h. Unset, the free tier is 3. A report is ~6 minutes of
# live research and real money, so this is the cost ceiling.
CASTOR_DAILY_RUNS=

# Auxiliary research per owner per rolling 24h, in its OWN bucket: /discover, /taste,
# /full and /research/crew. Unset, it is 5x CASTOR_DAILY_RUNS.
#
# These four ran with no ceiling at all, which meant anyone with a cookie could hold them
# open in a loop and spend the API budget without ever meeting the paywall. They are not
# charged a report credit — billing $29 for a competitor list would be absurd — and they
# are not charged the REPORT allowance either, because then looking up competitors would
# silently burn one of the reports the visitor came for. Separate bucket, cheaper work,
# its own number.
CASTOR_DAILY_AUX_RUNS=

# TESTING ONLY: stop asking anyone to pay, without unsetting the Stripe keys.
#
# Once the paywall works it stands in front of everything behind it — the refinement
# layer, the Q&A, the regeneration, the share reward — and re-buying a report to reach
# those is a tax on every pass through them. This suppresses the survey's gate and the
# server's 402; the ordinary free daily allowance takes over, so runs are still bounded.
# Checkout still works when called deliberately. It warns at startup, because an instance
# that has quietly stopped charging looks exactly like one that is selling.
CASTOR_PAYWALL_OFF=

# Close the door entirely: refuse anonymous visitors instead of giving them a guest
# workspace. For an install that is not a public product.
CASTOR_REQUIRE_LOGIN=

# Grant refinement packs without a payment. For an instance you run yourself only.
CASTOR_ALLOW_UNPAID_CREDITS=

# ---- Storage. The Dockerfile points the first three at the mounted volume. -----------
# CASTOR_TRANSCRIPT_DIR is NOT set there, so run transcripts land on the ephemeral image
# layer and vanish on redeploy. Set it onto the volume if you want them kept.
JOBS_DB_PATH=
LLM_CACHE_PATH=
HTTP_CACHE_PATH=
CASTOR_TRANSCRIPT_DIR=


# =============================================================== 3. RESEARCH ENGINE ===
# All optional. Each absence costs a named part of the report rather than breaking it.

# Web search cascade: Tavily, then Brave, then public SearXNG, then DuckDuckGo. With
# neither key the cascade runs on the free rungs, which .env.example has always described
# as flaky and rate-limited — and a total search failure produces a competitor roster
# recalled from model memory.
#   Tavily:   https://app.tavily.com/home
#   Brave:    https://api-dashboard.search.brave.com/app/keys
TAVILY_API_KEY=
BRAVE_SEARCH_KEY=

# US Census. Keyless requests return HTTP 200 with a "Missing Key" HTML page rather than
# an error, and the sizing engine then falls back to an LLM-estimated household count.
#   Free, instant: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Bureau of Labor Statistics: 25 requests/day unkeyed, 500 keyed. Spend curves for
# hyperlocal sizing.
#   Free: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Meta Ad Library — competitor ad-spend signal. Skipped entirely when absent.
#   https://developers.facebook.com/tools/explorer/  (ads_read permission)
META_ACCESS_TOKEN=

# Reddit OAuth. Absent, discovery falls back to public archives.
#   https://www.reddit.com/prefs/apps  (create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- Engine tuning ------------------------------------------------------------------
PIPELINE_PROFILE=default
LLM_BACKEND=
LLM_MODEL=
LLM_TIERING=
LLM_CACHE_BYPASS=
MRP_LOG_LEVEL=INFO


# =============================================================== 4. TESTING ONLY ======
# Both of these make the app lie in a controlled way. Neither belongs on a live instance,
# and each announces itself when it is on.

# DRAW THE PAYWALL WITH NO PROCESSOR WIRED, to look at the flow. The gate renders with
# list prices, says it is a preview, and offers a way past, because a wall that cannot
# take money is a bug rather than a paywall. Unset on anything real.
CASTOR_PAYWALL_PREVIEW=

# SKIP THE RESEARCH. Names a finished job id whose result is CLONED instead of running the
# six-minute pipeline, so the flow around a run — the gate, the credit, the progress page,
# the share offer — can be walked in a second. The clone is stamped `_stub: true`, its
# venture is renamed "(test run)", and its summary is replaced with the caller's own words,
# so it cannot be mistaken for research. Unset, runs are real.
CASTOR_STUB_REPORT=

# THE ONE PUBLIC REPORT behind /sample, named deliberately. Not a testing switch: this is
# how the landing page's "see a full report" link is meant to work in production.
CASTOR_SAMPLE_JOB_ID=

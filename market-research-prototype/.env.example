# LLM backend — set ONE of these API keys. Priority: groq > gemini > anthropic.
# All are free-tier capable except Anthropic.

# Groq (FREE, fastest) — get key at https://console.groq.com
GROQ_API_KEY=

# Google Gemini (FREE) — get key at https://aistudio.google.com
GEMINI_API_KEY=

# Anthropic (PAID) — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: force a backend (groq, gemini, anthropic). Auto-detected if unset.
LLM_BACKEND=

# Optional: override model slug. Defaults per backend:
#   groq     → llama-3.3-70b-versatile
#   gemini   → gemini-2.0-flash
#   anthropic → claude-haiku-4-5
LLM_MODEL=

# Optional: Meta Ad Library token (free, https://developers.facebook.com/tools/explorer/)
META_ACCESS_TOKEN=

# ── Web search backends (competitor discovery quality) ─────────────────────────
# The competitor DISCOVERY fan-out (skills/discovery_multi, wired into every run)
# searches the live web through this cascade: Tavily → Brave → public SearXNG → ddgs.
# WITHOUT a key it degrades to public SearXNG instances + ddgs, which are flaky and
# rate-limited — competitor sets get thinner and less reliable. Set at least one of
# these for production-grade, web-grounded discovery.
#
# Tavily (FREE 1k credits/mo, best quality) — https://tavily.com
TAVILY_API_KEY=
# Brave Search (FREE 2k queries/mo) — https://brave.com/search/api/
BRAVE_SEARCH_KEY=

# LLM backend — set ONE of these API keys. Priority: groq > gemini > anthropic.
# All are free-tier capable except Anthropic.

# Groq (FREE, fastest) — get key at https://console.groq.com
GROQ_API_KEY=

# Google Gemini (FREE) — get key at https://aistudio.google.com
GEMINI_API_KEY=

# Anthropic (PAID) — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: force a backend (groq, gemini, anthropic). Auto-detected if unset.
LLM_BACKEND=

# Optional: override model slug. Defaults per backend:
#   groq     → llama-3.3-70b-versatile
#   gemini   → gemini-2.0-flash
#   anthropic → claude-haiku-4-5
LLM_MODEL=

# Optional: Meta Ad Library token (free, https://developers.facebook.com/tools/explorer/)
META_ACCESS_TOKEN=

# ── Web search backends (competitor discovery quality) ─────────────────────────
# The competitor DISCOVERY fan-out (skills/discovery_multi, wired into every run)
# searches the live web through this cascade: Tavily → Brave → public SearXNG → ddgs.
# WITHOUT a key it degrades to public SearXNG instances + ddgs, which are flaky and
# rate-limited — competitor sets get thinner and less reliable. Set at least one of
# these for production-grade, web-grounded discovery.
#
# Tavily (FREE 1k credits/mo, best quality) — https://tavily.com
TAVILY_API_KEY=
# Brave Search (FREE 2k queries/mo) — https://brave.com/search/api/
BRAVE_SEARCH_KEY=

# --- US Census (free, no cost) -------------------------------------------------
# Measured 2026-07-28: api.census.gov answers HTTP 200 with an HTML "Missing Key" page
# for ACS, CBP AND SUSB when this is unset -- so the failure looks like "no data for that
# county" rather than "no key". Without it, trade-area household counts, establishment
# counts and payroll are unavailable, and any figure needing them must not be published as
# sourced (gate D53 enforces that).
# Free signup, instant: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# --- BLS Consumer Expenditure Survey (free, no cost) ---------------------------
# SET THIS. Measured 2026-08-04: the UNKEYED BLS v2 API allows only 25 requests/day per IP,
# and exhausting it returns HTTP **200** with status=REQUEST_NOT_PROCESSED -- so a quota
# failure looks like a missing series, not a missing key. It was exhausted during ordinary
# development, which took out `bls_cex_spend` and cost a whole trade-area TAM.
# A hyperlocal run makes TWO BLS calls (the national spend figure and the income-quintile
# curve), size_regional multiplies that by the number of sites, and scrape/http.py caches
# only GET/HEAD while BLS is POST -- so nothing absorbs the load. The curve is cached to
# .cex_curve_cache.json on success, which softens but does not remove this.
# A key raises the ceiling to 500/day. Free signup:
# https://data.bls.gov/registrationEngine/
#
# NOT instant, and NOT valid on arrival. MEASURED 2026-08-12 with a real 32-hex key: BLS
# answered HTTP 200, status=REQUEST_NOT_PROCESSED, "The key:... provided by the User is
# invalid." A registration key must be ACTIVATED from the confirmation email BLS sends;
# until you click that link it is well-formed and rejected. Verify before trusting it:
#
#   .venv/bin/python -c "import os,dotenv;dotenv.load_dotenv();\
#   from tools.econ import cex_income_quintile_curve as f;e=f();print(e.error or 'OK')"
#
# An invalid key is FAIL-SAFE but not free: the keyed request is rejected outright, so it
# is strictly worse than sending none. Leave this blank rather than set it to a key you
# have not confirmed — unkeyed 25/day plus .cex_curve_cache.json is the better fallback.
BLS_API_KEY=
